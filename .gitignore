.env
.env.*
!.env.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.auto.tfvars

# Infra build outputs and downloaded tools
infra/build/
infra/.tools/

# OS / editor
.DS_Store
*.swp
