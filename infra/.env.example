# Copy to .env (gitignored) and adjust. Nothing here is a secret: these are
# LocalStack dummy credentials and local endpoint URLs only.

# --- LocalStack endpoint (used by the smoke script and ad-hoc AWS CLI) ------
# IPv6 loopback: works on WSL2 mirrored-networking hosts where 127.0.0.1 to
# published ports is not reachable. Use http://localhost:4566 on hosts where
# plain IPv4 loopback works.
AWS_ENDPOINT_URL=http://[::1]:4566
AWS_DEFAULT_REGION=us-east-1

# Dummy credentials the AWS SDKs require even against LocalStack.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Terraform variables (infra/terraform) ---------------------------------
TF_VAR_aws_endpoint=http://[::1]:4566
TF_VAR_region=us-east-1
TF_VAR_environment=dev

# Set to a real endpoint (e.g. http://host.docker.internal:4566) only if the
# Lambda-in-LocalStack cannot reach the default injected endpoint.
TF_VAR_lambda_aws_endpoint=

# --- LocalStack container behaviour (docker-compose.yml) --------------------
DEBUG=0
LS_LOG=WARN
PERSISTENCE=0
